<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 成就外观只依赖标准 WPF；控件及数据仍由公开 PA 工厂提供。 -->
  <Style x:Key="TrophyHeader" TargetType="StackPanel"><Setter Property="Margin" Value="24,20,24,12"/></Style>
  <Style x:Key="TrophyContent" TargetType="ContentControl"><Setter Property="Margin" Value="24,0,24,24"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Border Background="#88101520" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="20"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
