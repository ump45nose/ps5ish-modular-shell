<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{DynamicResource Surface}">

  <Grid.Resources>
    <!-- 滚动条只保留窄灰色滑块和透明轨道；命中区宽度独立于视觉宽度。 -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#708E8E92" Width="2" HorizontalAlignment="Center"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
        <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#708E8E92" Height="2" VerticalAlignment="Center"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers>
    </Style>
    <!-- 音量条使用细轨道和小圆滑块，方向键按实际连续值调整。 -->
    <Style TargetType="Slider"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Height" Value="28"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Border Height="2" Background="#65808085" VerticalAlignment="Center"/><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"><Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#DDE2E2E4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Grid.Resources>
  <!-- 以 PS5ish 1920×1080 截图换算为 1280×720；壁纸模式由用户配置，游戏封面与功能入口分开呈现。 -->
  <Border Background="{DynamicResource AmbienceBrush}"/>
  <Image x:Name="Scene" Stretch="Uniform" Opacity="0.8"/>
  <Image x:Name="VideoLayer" Stretch="Uniform" Opacity="0"/>
  <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#42000000" Offset="0"/><GradientStop Color="#00000000" Offset="0.4"/><GradientStop Color="#BB05070A" Offset="1"/></LinearGradientBrush></Border.Background></Border>
  <Grid x:Name="Chrome" Margin="32,22,32,30">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="145"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="12,0,16,0"><TextBlock x:Name="Clock" DockPanel.Dock="Right" Foreground="White" FontSize="21" FontWeight="Light" VerticalAlignment="Center" Margin="28,0,0,0"/>
      <Button x:Name="Settings" DockPanel.Dock="Right" Content="⚙" Style="{DynamicResource NavigationStyle}" Margin="12,0,0,0"/>
      <Button x:Name="Palette" DockPanel.Dock="Right" Content="◉" Visibility="Collapsed" Style="{DynamicResource NavigationStyle}"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Home" Content="游戏" FontWeight="SemiBold" Style="{DynamicResource NavigationStyle}"/><Button x:Name="HubAction" Content="媒体" Visibility="Collapsed" Style="{DynamicResource NavigationStyle}" Margin="16,0,0,0"/><Button x:Name="Library" Content="游戏库" Visibility="Collapsed" Style="{DynamicResource NavigationStyle}"/></StackPanel>
    </DockPanel>
    <ListBox x:Name="Games" FocusVisualStyle="{x:Null}" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" KeyboardNavigation.DirectionalNavigation="Contained">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <!-- 焦点框只围绕方形封面，不随容器行高或标题区域拉伸。 -->
        <Grid><ContentPresenter Margin="2" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Top"/><Border x:Name="Ring" Width="{DynamicResource TileFrameSize}" Height="{DynamicResource TileFrameSize}" HorizontalAlignment="Center" VerticalAlignment="Top" BorderThickness="1" BorderBrush="Transparent" CornerRadius="{DynamicResource TileRadius}" IsHitTestVisible="False"/></Grid>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Ps5FocusBrush}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
        <StackPanel Width="{DynamicResource TileSize}">
          <Border x:Name="CoverFrame" Height="{DynamicResource TileSize}" Width="{DynamicResource TileSize}" CornerRadius="{DynamicResource TileRadius}" BorderThickness="0" Padding="0" BorderBrush="Transparent" Background="#28202731" ClipToBounds="True">
            <Grid><TextBlock x:Name="FallbackTitle" Text="{Binding Title}" Foreground="White" FontSize="13" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="8" VerticalAlignment="Center" MaxHeight="58"/>
              <Rectangle RadiusX="{DynamicResource TileImageRadius}" RadiusY="{DynamicResource TileImageRadius}"><Rectangle.Fill><ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle>
              <StackPanel x:Name="LibraryGlyph" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"><Path Fill="White" Width="34" Height="34" Stretch="Uniform" Data="{DynamicResource LibraryIconGeometry}"/></StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="{Binding Title}" Visibility="{DynamicResource TitleStripVisibility}" Foreground="White" FontSize="14" TextTrimming="CharacterEllipsis" Margin="1,8,1,0"/>
          <TextBlock Text="{Binding Item.Platform}" Visibility="{DynamicResource TitleStripVisibility}" Foreground="#ADB0B8" FontSize="10" Margin="1,3,0,0"/>
        </StackPanel>
        <DataTemplate.Triggers><DataTrigger Binding="{Binding IsLibraryEntry}" Value="True"><Setter TargetName="FallbackTitle" Property="Visibility" Value="Collapsed"/><Setter TargetName="LibraryGlyph" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <!-- 名称紧随卡片横条，底部留给游戏 Logo 与启动操作，不重复堆叠大标题。 -->
    <TextBlock x:Name="Title" Grid.Row="1" Margin="214,96,20,0" VerticalAlignment="Top" FontSize="21" FontWeight="Light" Foreground="White" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="80,0,0,44">
      <TextBlock x:Name="Metadata" FontSize="12" Foreground="#CCFFFFFF" Margin="4,0,0,12"/>
      <StackPanel Orientation="Horizontal"><Button x:Name="Start" Content="开始游戏" Width="220" FontWeight="SemiBold" Style="{DynamicResource ActionStyle}"/><Button x:Name="Details" Content="•••" ToolTip="游戏详情与操作" Width="50" Padding="0" Style="{DynamicResource ActionStyle}" Margin="14,0,0,0"/><Button x:Name="Trailer" Content="▷" ToolTip="观看预告" Width="50" Padding="0" Style="{DynamicResource ActionStyle}" Margin="14,0,0,0"/></StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="80,0,0,0"><TextBlock x:Name="Status" FontSize="11" Foreground="#A8FFFFFF" TextWrapping="Wrap"/><StackPanel x:Name="Sections" Visibility="Collapsed"/></StackPanel>
  </Grid>
  <TextBlock x:Name="TrailerHints" Text="× / Space 暂停与继续    ○ / Esc 返回游戏" Foreground="White" Background="#BB08101D" FontSize="18" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,25" Visibility="Collapsed"/>
  <!-- 设置与详情覆盖层只声明展示；所有选择、保存与返回由宿主命令驱动。 -->
  <Grid x:Name="SettingsPage" Visibility="Collapsed" Background="Transparent" KeyboardNavigation.TabNavigation="Cycle">
    <ScrollViewer Width="800" MaxHeight="650" VerticalAlignment="Center" HorizontalAlignment="Center" VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
      <TextBlock Text="浏览与播放设置" FontSize="32" Foreground="White" Margin="0,0,0,24"/>
      <Expander Header="插件诊断" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"><TextBlock x:Name="PluginDiagnostic" FontSize="14" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></Expander>
      <CheckBox x:Name="OptionAutoVideo" Style="{DynamicResource OptionStyle}" Content="停留后自动播放背景视频" FontSize="22" Foreground="White"/>
      <CheckBox x:Name="OptionMusic" Style="{DynamicResource OptionStyle}" Content="播放背景音乐" FontSize="22" Foreground="White"/>
      <CheckBox x:Name="OptionTrailerAudio" Style="{DynamicResource OptionStyle}" Content="视频就绪后由预告原声接管" FontSize="22" Foreground="White"/>
      <CheckBox x:Name="OptionReducedMotion" Style="{DynamicResource OptionStyle}" Content="减少动态效果" FontSize="22" Foreground="White"/>
      <CheckBox x:Name="OptionNightMode" Style="{DynamicResource OptionStyle}" Content="夜间低音量" FontSize="22" Foreground="White"/>
      <CheckBox x:Name="OptionController" Style="{DynamicResource OptionStyle}" Content="启用手柄（DS5 / XInput）" FontSize="22" Foreground="White"/>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="LayoutChoice" Content="布局：PS5ish" Style="{DynamicResource ActionStyle}"/><Button x:Name="Maintenance" Content="素材与配置维护（键鼠）" Style="{DynamicResource ActionStyle}" Margin="16,0,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="MotionChoice" Content="切换动效包" Style="{DynamicResource ActionStyle}"/><Button x:Name="AmbienceChoice" Content="切换氛围资产" Style="{DynamicResource ActionStyle}" Margin="16,0,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="SaveSettings" Content="保存" Style="{DynamicResource ActionStyle}"/><Button x:Name="CancelSettings" Content="返回" Style="{DynamicResource ActionStyle}" Margin="16,0,0,0"/></StackPanel>
      <TextBlock x:Name="SettingsError" Foreground="{DynamicResource Accent}" FontSize="16" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel></ScrollViewer>
  </Grid>
  <Grid x:Name="DetailsPage" Visibility="Collapsed" Background="#FA080B12" KeyboardNavigation.TabNavigation="Cycle"><Image x:Name="DetailScene" Stretch="Uniform" Opacity="0.16" IsHitTestVisible="False"/>
    <StackPanel Width="1000" VerticalAlignment="Center" HorizontalAlignment="Center">
      <DockPanel><Image x:Name="DetailCover" Width="110" Height="140" Stretch="UniformToFill" Margin="0,0,28,0"/><TextBlock x:Name="DetailTitle" FontSize="40" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
      <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,20,0,24"><TextBlock x:Name="DetailInfo" FontSize="19" Foreground="#BACADD" TextWrapping="Wrap"/></ScrollViewer>
      <Button x:Name="ContextPageAction" Content="扩展详情" Visibility="Collapsed" Style="{DynamicResource ActionStyle}" HorizontalAlignment="Left" Margin="0,0,0,18"/>
      <Button x:Name="BackDetails" Content="返回游戏" Style="{DynamicResource ActionStyle}" HorizontalAlignment="Left"/>
    </StackPanel>
  </Grid>
</Grid>








