<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 组件只表现焦点和状态，不执行导航、启动或播放。 -->
  <!-- 服务图标采用游戏首页的 80px 方卡基准，避免影院宽卡样式挤压图标。 -->
  <DataTemplate x:Key="MediaServiceTemplate"><Image Source="{Binding Cover}" Width="71" Height="71" Stretch="Uniform"/></DataTemplate>
  <Style x:Key="MediaServiceStyle" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid Width="80" Height="80"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="Ring" Width="77" Height="77" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Ps5FocusBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <LinearGradientBrush x:Key="Ps5FocusBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#EAEDF6FF" Offset="0"/><GradientStop Color="#6687ACC7" Offset=".42"/><GradientStop Color="#BBFFFFFF" Offset="1"/></LinearGradientBrush>
  <Style x:Key="Ps5ShellSettingRowStyle" TargetType="Button">
    <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="20"/><Setter Property="MinHeight" Value="62"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Row" CornerRadius="3" Padding="14,12" BorderThickness="1" BorderBrush="Transparent" Background="{TemplateBinding Background}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Ps5FocusBrush}"/><Setter TargetName="Row" Property="Background" Value="#12FFFFFF"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Ps5FocusBrush}"/><Setter TargetName="Row" Property="Background" Value="#06FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ActionStyle" TargetType="Button">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="Padding" Value="28,12"/>
    <Setter Property="MinHeight" Value="50"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Background" Value="#24FFFFFF"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="24" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Ps5FocusBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Ps5FocusBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.65"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.32"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- 工具按钮使用严格圆形模板，避免胶囊圆角在底部形成平边。 -->
  <Style x:Key="Ps5CircleButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionStyle}">
    <Setter Property="Width" Value="50"/><Setter Property="Height" Value="50"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Body" CornerRadius="999" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1.2">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Ps5FocusBrush}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Ps5FocusBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".65"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- 所有搜索入口共用透明下划线输入框；未实现语音输入，因此不绘制虚假的麦克风按钮。 -->
  <Style x:Key="Ps5SearchBoxStyle" TargetType="TextBox">
    <Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="MinHeight" Value="46"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="SearchLine" BorderBrush="#558A919C" BorderThickness="0,0,0,1" Background="Transparent" Padding="2,8,2,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Path Width="22" Height="22" Stretch="Uniform" Stroke="White" StrokeThickness="2" Data="M 15,8 A 7,7 0 1 1 1,8 A 7,7 0 1 1 15,8 M 13,13 L 21,21" VerticalAlignment="Center"/>
          <TextBlock x:Name="Hint" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="#88FFFFFF" IsHitTestVisible="False" VerticalAlignment="Center" Visibility="Collapsed"/>
          <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Text" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="SearchLine" Property="BorderBrush" Value="#CCEDF3FA"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NavigationStyle" TargetType="Button" BasedOn="{StaticResource ActionStyle}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="20,8"/><Setter Property="FontSize" Value="20"/>
  </Style>
  <Style x:Key="OptionStyle" TargetType="CheckBox">
    <Setter Property="FontSize" Value="22"/><Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,3"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
        <DockPanel><Border x:Name="Mark" DockPanel.Dock="Right" Width="44" Height="24" CornerRadius="12" Background="{DynamicResource Card}" Margin="24,0,0,0"><Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{DynamicResource Muted}" HorizontalAlignment="Left" Margin="4"/></Border><ContentPresenter VerticalAlignment="Center"/></DockPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Mark" Property="Background" Value="White"/><Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Surface}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Ps5FocusBrush}"/></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusRing" Property="Background" Value="#22222222"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>

